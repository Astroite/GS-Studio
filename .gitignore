# MediaSDK is an external licensed dependency; never vendor or commit its build outputs.
tools/mediasdk-helper/build/
tools/mediasdk-helper/vendor/
tools/mediasdk-helper/**/*.dll
tools/mediasdk-helper/**/*.lib
tools/mediasdk-helper/**/*.exe

# The Insta360 MediaSDK payload is an external licensed dependency; never commit it.
sdks/
# Native wheels and CUDA build output stay local; target architecture is recorded per build.
wheels/

# Test scripts live in tests/ and are versioned; test byproducts never are.
tests/output/
tests/.tmp/

# Data belongs to the separate Data repository; a stray Data-shaped tree in APP
# (e.g. a relative export path) must never be committed.
locations/

# Local runtime, tools, projects and secrets are preserved on disk, never published.
/runtime/
/cache/
/.cache/
/data/
/Data/
/projects/
/private/
.env
.env.*
!.env.example
*.key
*.pem
*.pfx

# Frontend/native build products and raw historical evidence.
node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
engine/release/
engine/evidence/
engine/reference/evidence/
*.pyd
*.dll
*.lib
*.obj
*.exe

