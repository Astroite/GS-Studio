{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GS Studio",
  "version": "0.3.0-rc.1",
  "identifier": "studio.gsstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "GS Studio",
      "width": 1440,
      "height": 960,
      "minWidth": 1100,
      "minHeight": 760,
      "backgroundColor": "#0c1012",
      "theme": "Dark",
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Local Gaussian Splatting workbench"
  }
}
